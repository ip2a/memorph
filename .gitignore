# Ignore everything by default.
*

# Keep directory traversal so whitelisted paths below can be reached.
!*/

# Always ignore local-only directories and artifacts.
/.claude/
/.idea/
/.memorph/
/target/
/reference-projects/
/归档/
/RUN.md
/bot
/bot.*
/issy
/issy.*
/desktop/tauri/.idea/
/desktop/tauri/.memorph/
/desktop/tauri/gen/
/desktop/tauri/target/
**/__pycache__/

# Root project metadata.
!/.gitignore
!/platforms.toml
!/LICENSE
!/install.sh
!/README.md
!/README_en.md
!/README_zh.md

# Rust workspace.
!/rust/
!/rust/Cargo.toml
!/rust/Cargo.lock
!/rust/crates/
!/rust/crates/**/Cargo.toml
!/rust/crates/**/*.rs
!/rust/crates/**/assets/
!/rust/crates/**/assets/*.json
/rust/crates/**/assets/web/
!/rust/apps/
!/rust/apps/**/Cargo.toml
!/rust/apps/**/*.rs
!/rust/apps/**/assets/
!/rust/apps/**/assets/*.json
/rust/apps/**/assets/web/

# GitHub workflows.
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml

# Local draft documentation.
/docs/*
# 规范文档作为架构验收标准,纳入版本控制
!/docs/架构文档-重要架构设计v1.md
!/docs/项目骨架设计v1.md
!/docs/重构计划-v1.md
!/docs/技术文档-LIB说明v1.md

# Web app source.
!/apps/
!/apps/web/
!/apps/web/**
/apps/web/node_modules/
/apps/web/dist/

# Assets used by the published project.
!/assets/
!/assets/**

# Build and release scripts.
!/scripts/
!/scripts/*.sh
!/scripts/*.py

# Desktop Tauri app source and config.
!/desktop/
!/desktop/tauri/
!/desktop/tauri/Cargo.toml
!/desktop/tauri/Cargo.lock
!/desktop/tauri/build.rs
!/desktop/tauri/tauri.conf.json
!/desktop/tauri/icon-source.png
!/desktop/tauri/capabilities/
!/desktop/tauri/capabilities/**
!/desktop/tauri/icons/
!/desktop/tauri/icons/**
!/desktop/tauri/src/
!/desktop/tauri/src/**/*.rs

# npm package manifests and launcher script.
!/npm/
!/npm/**/
!/npm/**/package.json
!/npm/**/README.md
!/npm/packages/memorph/bin/
!/npm/packages/memorph/bin/*.js

# Python package manifests and source entrypoints.
!/python/
!/python/**/
!/python/**/pyproject.toml
!/python/**/README.md
!/python/packages/memorph/src/
!/python/packages/memorph/src/memorph/
!/python/packages/memorph/src/memorph/*.py

# Research notes (not part of the project source).
/headroom的调研报告.md
/memorph基于headroom完善压缩机制。md

# Provider-native test fixtures.
!/rust/crates/memorph/src/providers/kimi/fixtures/
!/rust/crates/memorph/src/providers/kimi/fixtures/**
!/rust/crates/memorph/src/providers/kiro/fixtures/
!/rust/crates/memorph/src/providers/kiro/fixtures/**
!/rust/crates/memorph/src/providers/cursor/fixtures/
!/rust/crates/memorph/src/providers/cursor/fixtures/**

# Project-wide Codex experience instructions.
!AGENTS.md
!.agent/
!.agent/config.toml
!docs/codex-experience.md
